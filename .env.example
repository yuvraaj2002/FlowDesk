LLM__PROVIDER=ollama
LLM__MODEL=LiquidAI/lfm2.5-1.2b-instruct:latest
LLM__BASE_URL=http://localhost:11434
LLM__TEMPERATURE=0.2

ROUTER__ENABLED=true
ROUTER__MODEL=tev1:0.8b
ROUTER__BASE_URL=http://localhost:11434
ROUTER__MIN_CONFIDENCE=0.35

GUARD__ENABLED=true
# Default works ungated. For Meta Prompt Guard after HF license accept:
# GUARD__MODEL=meta-llama/Prompt-Guard-86M
GUARD__MODEL=protectai/deberta-v3-base-prompt-injection-v2
GUARD__DEVICE=auto
GUARD__JAILBREAK_THRESHOLD=0.85

QDRANT__URL=http://localhost:6333
QDRANT__COLLECTION=flowdesk_kb

EMBED__MODEL=BAAI/bge-small-en-v1.5
EMBED__DEVICE=auto
EMBED__BATCH_SIZE=64
EMBED__VECTOR_SIZE=384

RETRIEVAL__TOP_K=8
